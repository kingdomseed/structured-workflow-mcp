{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/codex/act-codex-log-session.js\""
          }
        ],
        "description": "[ACT] Log Codex SessionStart activity to ai_logs/"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/codex/act-codex-log-session.js\""
          }
        ],
        "description": "[ACT] Log Codex UserPromptSubmit activity to ai_logs/"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/codex/act-codex-log-session.js\""
          }
        ],
        "description": "[ACT] Log Codex PreToolUse activity to ai_logs/"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/codex/act-codex-log-session.js\""
          }
        ],
        "description": "[ACT] Log Codex PermissionRequest activity to ai_logs/"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/codex/act-codex-dart-format.js\"",
            "timeout": 30,
            "statusMessage": "Formatting Dart files"
          }
        ],
        "description": "[ACT] Auto-format Dart files after Codex edits (excludes generated .g.dart files)"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/codex/act-codex-log-session.js\""
          }
        ],
        "description": "[ACT] Log Codex PostToolUse activity to ai_logs/"
      }
    ]
  }
}

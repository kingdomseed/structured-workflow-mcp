{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/hooks/claude/act-claude-statusline.js\"",
    "description": "[ACT] Statusline: context | model | directory | branch | task"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log SessionStart activity to ai_logs/"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log UserPromptSubmit activity to ai_logs/"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log PreToolUse activity to ai_logs/"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-dart-format.js\""
          }
        ],
        "description": "[ACT] Auto-format Dart files after edits (excludes generated .g.dart files)"
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log AskUserQuestion answers to ai_logs/"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log PostToolUseFailure activity to ai_logs/"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log PermissionRequest activity to ai_logs/"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log SubagentStart activity to ai_logs/"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log SubagentStop activity to ai_logs/"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log PreCompact activity to ai_logs/"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/claude/act-claude-log-session.js\""
          }
        ],
        "description": "[ACT] Log SessionEnd activity to ai_logs/"
      }
    ]
  }
}
